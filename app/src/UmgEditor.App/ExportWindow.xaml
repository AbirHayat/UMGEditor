<Window x:Class="UmgEditor.App.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UmgEditor.App.ViewModels"
        Title="{Binding Project, StringFormat='Export mod — project {0}'}" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:NullToVisibilityConverter x:Key="NullToVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <vm:InverseBoolConverter x:Key="InverseBoolToEnabled" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14,10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#333">
            Packs the project's <Run FontWeight="SemiBold" Text="saved" /> edits into one mod container (retoc pack-raw, the eFootball container header, the .pak stub),
            verifies it (retoc verify, CUE4Parse read-back) and writes the predicted layouts and test instructions next to it. Nothing outside work\out\mods\NAME is written; the game files are only read.
        </TextBlock>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="ExportCloseButton" DockPanel.Dock="Right" Content="Close" Padding="16,3" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
            <Button x:Name="OpenInstructionsButton" DockPanel.Dock="Right" Content="Open test instructions" Padding="10,3" Margin="8,0,0,0" Command="{Binding OpenInstructionsCommand}" />
            <Button x:Name="OpenModFolderButton" DockPanel.Dock="Right" Content="Open folder" Padding="10,3" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
            <Button x:Name="ExportBuildButton" DockPanel.Dock="Right" Content="Build mod" Padding="18,3" FontWeight="SemiBold" Command="{Binding BuildCommand}"
                    ToolTip="Builds in the background; refused while anything is listed in red" />
            <ProgressBar DockPanel.Dock="Left" Width="160" Height="12" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}" />
        </DockPanel>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the request -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding IsBuilding, Converter={StaticResource InverseBoolToEnabled}}">
                    <TextBlock Style="{StaticResource Label}" Text="Mod name" />
                    <TextBox x:Name="ExportModName" Padding="3,2" Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="ExportOutDir" Style="{StaticResource Hint}" Text="{Binding OutDirText}" />

                    <TextBlock Style="{StaticResource Label}" Text="Container name" />
                    <TextBox x:Name="ExportContainer" Padding="3,2" Text="{Binding ContainerName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Must end in _P (a patch container, mounted after the stock ones). The device gets NAME.utoc, NAME.ucas and NAME.pak." />

                    <TextBlock Style="{StaticResource Label}" Text="Packages with saved edits" />
                    <TextBlock Style="{StaticResource Hint}" Text="No package of this project has saved edits yet." Visibility="{Binding HasPackages, Converter={StaticResource InverseBoolToVis}}" />
                    <ItemsControl x:Name="ExportPackageList" ItemsSource="{Binding Packages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" FontWeight="SemiBold" AutomationProperties.AutomationId="{Binding Name, StringFormat='ExportPackage_{0}'}" />
                                    <TextBlock Margin="8,0,0,0" Foreground="#666" Text="{Binding Note}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Label}" Text="retoc" />
                    <DockPanel>
                        <Button x:Name="BrowseRetocButton" DockPanel.Dock="Right" Content="Browse…" Padding="8,1" Margin="6,0,0,0" Command="{Binding BrowseRetocCommand}" />
                        <TextBox x:Name="ExportRetocPath" Padding="3,2" Text="{Binding RetocPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Setting RetocPath in umgeditor.json; saved when a build starts" />
                    </DockPanel>
                    <TextBlock x:Name="ExportRetocInfo" FontFamily="Consolas" Text="{Binding RetocText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Foreground" Value="#B45309" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RetocTested}" Value="True">
                                        <Setter Property="Foreground" Value="#047857" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Margin="0,14,0,0" Padding="8,6" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding RefusalsText, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#991B1B" Text="Can't build yet" />
                            <TextBlock x:Name="ExportRefusals" TextWrapping="Wrap" Foreground="#991B1B" Text="{Binding RefusalsText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,8,0,0" Padding="8,6" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding WarningsText, Converter={StaticResource NullToVis}}">
                        <TextBlock x:Name="ExportWarnings" TextWrapping="Wrap" Foreground="#92400E" Text="{Binding WarningsText}" />
                    </Border>

                    <!-- the Impact panel's warnings for the picked edits; each Danger one needs its tick before Build -->
                    <TextBlock x:Name="ExportImpactWarningsHeader" Style="{StaticResource Label}" Text="{Binding ImpactWarningsHeader}"
                               AutomationProperties.HelpText="{Binding ImpactWarningsText}" />
                    <TextBlock x:Name="ExportImpactWarnings" Style="{StaticResource Hint}" Text="{Binding ImpactWarningsText}"
                               Visibility="{Binding HasImpactWarnings, Converter={StaticResource InverseBoolToVis}}" />
                    <ItemsControl x:Name="ExportImpactWarningList" ItemsSource="{Binding ImpactWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="8,5" BorderThickness="1" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB" />
                                            <Setter Property="BorderBrush" Value="#FCD34D" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                    <Setter Property="BorderBrush" Value="#F87171" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Text}" AutomationProperties.AutomationId="{Binding TextId}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <CheckBox Margin="0,5,0,0" FontWeight="SemiBold" Foreground="#991B1B" IsChecked="{Binding IsAcknowledged}"
                                                  AutomationProperties.AutomationId="{Binding AckId}"
                                                  Content="I've read this: build anyway"
                                                  Visibility="{Binding IsDanger, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- the build -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Padding="8,6" CornerRadius="3" BorderThickness="1" Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FCA5A5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultOk}" Value="True">
                                    <Setter Property="Background" Value="#ECFDF5" />
                                    <Setter Property="BorderBrush" Value="#6EE7B7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="ExportResultText" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ResultText}" />
                </Border>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="Files for the device" />
                <ListView x:Name="ExportFiles" DockPanel.Dock="Top" ItemsSource="{Binding Files}" Height="112">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File" Width="190" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Size}" />
                            <GridViewColumn Header="sha256" Width="440" DisplayMemberBinding="{Binding Sha256}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="Log" />
                <TextBox x:Name="ExportLog" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding Log, Mode=OneWay}" TextChanged="OnLogChanged" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
