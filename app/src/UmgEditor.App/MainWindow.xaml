<Window x:Class="UmgEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UmgEditor.App.ViewModels"
        xmlns:pv="clr-namespace:UmgEditor.App.Preview"
        Title="eFootball Mobile UMG Editor" Height="860" Width="1500" MinWidth="1100" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:NullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Value" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- source -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Rebuild index" Padding="10,2" Command="{Binding RebuildCommand}" />
                <TextBlock VerticalAlignment="Center">
                    <Run Foreground="#666" Text="Stock Paks (read-only): " /><Run Text="{Binding PaksDir, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- status -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="160" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="380" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="4*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 1. browser -->
            <DockPanel Margin="10">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"
                             ToolTip="Search the package path; space-separated words must all match" />
                </Grid>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" />
                    <ComboBox Grid.Column="1" Width="100" Margin="6,0,0,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
                    <CheckBox Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Content="Thumbs"
                              IsChecked="{Binding IncludeBulkImages}" ToolTip="Include ~74k player thumbnails and emblems (listed, not inspected)" />
                </Grid>
                <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Kind" Width="70" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="Group" Width="150" DisplayMemberBinding="{Binding Group}" />
                            <GridViewColumn Header="Container" Width="150" DisplayMemberBinding="{Binding Container}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E5E5" />

            <!-- 2. widget tree -->
            <DockPanel Grid.Column="2" Margin="10">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Selected.Name, FallbackValue='Widget tree'}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="#666" TextWrapping="Wrap" Text="{Binding Selected.Container}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Foreground="#666" Text="Shown on: " /><Run Text="{Binding PackageBoards, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,8" Foreground="#444" TextWrapping="Wrap" Text="{Binding TreeStatus}" />
                </StackPanel>
                <TabControl x:Name="MiddleTabs">
                <TabItem Header="Tree">
                <TreeView x:Name="WidgetTreeView" ItemsSource="{Binding TreeRoots}" SelectedItemChanged="OnTreeSelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:WidgetNodeViewModel}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock x:Name="ClassText" Text="{Binding ClassName}" Foreground="#888" Margin="6,0,0,0" />
                                <Border Style="{StaticResource Badge}" Background="#D97706" ToolTip="{Binding AnimationTooltip}"
                                        Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="anim" />
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#DC2626" ToolTip="A margin or 2D-transform animation moves this element at runtime"
                                        Visibility="{Binding IsMovedByAnimation, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="moves" />
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#6B7280" ToolTip="Clips its children to its bounds"
                                        Visibility="{Binding ClipsToBounds, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="clip" />
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#2563EB" ToolTip="Instance of another widget blueprint; expand to see its contents (read-only)"
                                        Visibility="{Binding IsEmbeddedInstance, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="widget" />
                                </Border>
                            </StackPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter TargetName="NameText" Property="Foreground" Value="#888" />
                                    <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                                    <Setter TargetName="NameText" Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMessage}" Value="True">
                                    <Setter TargetName="NameText" Property="Foreground" Value="#888" />
                                    <Setter TargetName="NameText" Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                </TabItem>
                <TabItem Header="Preview">
                    <DockPanel DataContext="{Binding Preview}" Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel>
                                <ComboBox Width="290" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />
                                <TextBox Width="56" Margin="8,0,0,0" Padding="2" Text="{Binding ViewportWidth, UpdateSourceTrigger=LostFocus}" ToolTip="Viewport width (px)" />
                                <TextBlock Text=" × " VerticalAlignment="Center" />
                                <TextBox Width="56" Padding="2" Text="{Binding ViewportHeight, UpdateSourceTrigger=LostFocus}" ToolTip="Viewport height (px)" />
                                <Button Content="Export PNG + rects" Margin="8,0,0,0" Padding="8,1" Command="{Binding ExportCommand}"
                                        ToolTip="Writes the preview at native resolution and every widget rect (px, px per unit) to work/out/preview" />
                            </WrapPanel>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#333" FontSize="11.5" Text="{Binding ScaleInfo}" />
                            <WrapPanel Margin="0,6,0,6">
                                <CheckBox Margin="0,0,12,0" Content="Outlines" IsChecked="{Binding ShowOutlines}" />
                                <CheckBox Margin="0,0,12,0" Content="Approximated" Foreground="#C2410C" IsChecked="{Binding HighlightAssumed}"
                                          ToolTip="Orange dashed: geometry from an unmodelled panel or an estimated auto-size" />
                                <CheckBox Margin="0,0,12,0" Content="Moved by animation" Foreground="#B91C1C" IsChecked="{Binding HighlightAnimated}"
                                          ToolTip="Red dotted: a margin or 2D-transform animation moves this at runtime. The preview shows the stored pose." />
                                <CheckBox Margin="0,0,12,0" Content="Clip rects" IsChecked="{Binding ShowClipRects}" />
                                <CheckBox Content="Hidden widgets" IsChecked="{Binding ShowHidden}" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <WrapPanel>
                                <Button Content="Screenshot underlay…" Padding="8,1" Command="{Binding LoadUnderlayCommand}" />
                                <Button Content="Clear" Margin="6,0,0,0" Padding="8,1" Command="{Binding ClearUnderlayCommand}" />
                                <TextBlock Text="  opacity " VerticalAlignment="Center" Foreground="#666" />
                                <Slider Width="110" Minimum="0" Maximum="1" Value="{Binding UnderlayOpacity}" VerticalAlignment="Center" />
                                <TextBlock Text="  game area x,y,w,h " VerticalAlignment="Center" Foreground="#666" />
                                <TextBox Width="130" Padding="2" Text="{Binding UnderlayCropText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Where the game view sits inside the screenshot (LDPlayer 1920x1080: 50,32,1786,1000)" />
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,0" Foreground="#444" TextWrapping="Wrap" Text="{Binding Status}" />
                        </StackPanel>
                        <pv:PreviewCanvas x:Name="PreviewCanvas" ClipToBounds="True" Layout="{Binding Layout}" Renderer="{Binding Renderer}"
                                          Options="{Binding Options}" Underlay="{Binding Underlay}" UnderlayOpacity="{Binding UnderlayOpacity}"
                                          UnderlayCrop="{Binding UnderlayCrop}" />
                    </DockPanel>
                </TabItem>
                </TabControl>
            </DockPanel>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E5E5E5" />

            <!-- 3. node details -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,10">
                    <TextBlock Text="{Binding SelectedNode.Name, FallbackValue='Select a widget'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Foreground="#666" Text="{Binding SelectedNode.Node.ClassPath}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding NodeSource}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Foreground="#666" Text="Package shown on: " /><Run Text="{Binding NodeBoards, Mode=OneWay}" />
                    </TextBlock>

                    <!-- slot -->
                    <StackPanel Visibility="{Binding SelectedNode.HasSlot, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBlock Style="{StaticResource Section}">
                        <Run Text="Slot " /><Run Text="{Binding SelectedNode.Node.Slot.Name, Mode=OneWay}" /><Run Foreground="#888" FontWeight="Normal" Text="{Binding SelectedNode.Node.Slot.ClassName, Mode=OneWay, StringFormat=' ({0})'}" />
                    </TextBlock>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap"
                               Text="Black = stored in the file (editable later). Grey = not stored; the engine default applies and can't be patched in place." />
                    <ItemsControl ItemsSource="{Binding SelectedNode.Node.Slot.Fields}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="P" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <TextBlock x:Name="V" Grid.Column="1" Text="{Binding Value}" TextAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock x:Name="S" Grid.Column="2" Text="stored" Foreground="#15803D" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Stored}" Value="False">
                                        <Setter TargetName="P" Property="Foreground" Value="#A0A0A0" />
                                        <Setter TargetName="V" Property="Foreground" Value="#A0A0A0" />
                                        <Setter TargetName="V" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="V" Property="FontStyle" Value="Italic" />
                                        <Setter TargetName="S" Property="Text" Value="default" />
                                        <Setter TargetName="S" Property="Foreground" Value="#A0A0A0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>

                    <!-- layout (from the preview) -->
                    <StackPanel DataContext="{Binding Preview.SelectedBox}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <TextBlock Style="{StaticResource Section}" Text="Layout (preview)" />
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Bounds.X, Mode=OneWay, StringFormat='x {0:0.#}'}" /><Run Text="{Binding Bounds.Y, Mode=OneWay, StringFormat=', y {0:0.#}'}" /><Run Text="{Binding Bounds.Width, Mode=OneWay, StringFormat=',  {0:0.#}'}" /><Run Text="{Binding Bounds.Height, Mode=OneWay, StringFormat=' × {0:0.#} px'}" />
                            <Run Foreground="#666" Text="{Binding PixelsPerUnit, Mode=OneWay, StringFormat='  ·  {0:0.####} px per unit'}" />
                        </TextBlock>
                        <TextBlock Foreground="#C2410C" TextWrapping="Wrap" Text="{Binding Approximation}" />
                        <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,2"
                                   Text="Inputs: black = stored in the file, grey = engine default, orange = assumed, blue = computed or config." />
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="N" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock x:Name="V" Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="6,0" MaxWidth="170" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                        <TextBlock x:Name="S" Grid.Column="2" Text="{Binding Source}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="#15803D" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="EngineDefault">
                                            <Setter TargetName="N" Property="Foreground" Value="#A0A0A0" />
                                            <Setter TargetName="V" Property="Foreground" Value="#A0A0A0" />
                                            <Setter TargetName="V" Property="FontStyle" Value="Italic" />
                                            <Setter TargetName="V" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="S" Property="Foreground" Value="#A0A0A0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="Assumed">
                                            <Setter TargetName="S" Property="Foreground" Value="#C2410C" />
                                            <Setter TargetName="V" Property="Foreground" Value="#C2410C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="Computed">
                                            <Setter TargetName="S" Property="Foreground" Value="#2563EB" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="Config">
                                            <Setter TargetName="S" Property="Foreground" Value="#2563EB" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- animations -->
                    <TextBlock Style="{StaticResource Section}" Text="Animations" />
                    <TextBlock Foreground="#888" Text="Not animated."
                               Visibility="{Binding SelectedNode.IsNotAnimated, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                    <ItemsControl ItemsSource="{Binding SelectedNode.Node.Animations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,1">
                                    <Run Text="{Binding Animation, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Target, Mode=OneWay, StringFormat='— {0}'}" Foreground="#888" />
                                    <LineBreak /><Run Foreground="#555" Text="{Binding Tracks.Count, Mode=OneWay, StringFormat='{}{0} track(s): '}" />
                                    <Run Foreground="#555" Text="{Binding TracksText, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- other stored properties -->
                    <TextBlock Style="{StaticResource Section}" Text="Stored widget properties" />
                    <ItemsControl ItemsSource="{Binding SelectedNode.Node.StoredProperties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
