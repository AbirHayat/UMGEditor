<Window x:Class="UmgEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eFootball Mobile UMG Editor" Height="800" Width="1280" MinWidth="900" MinHeight="500"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="Value" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- source -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Rebuild index" Padding="10,2" Command="{Binding RebuildCommand}" />
                <TextBlock VerticalAlignment="Center">
                    <Run Foreground="#666" Text="Stock Paks (read-only): " /><Run Text="{Binding PaksDir, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- status -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="160" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- browser -->
            <DockPanel Margin="10">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"
                             ToolTip="Search the package path; space-separated words must all match" />
                    <ComboBox Grid.Column="1" Width="190" Margin="8,0,0,0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" />
                    <ComboBox Grid.Column="2" Width="110" Margin="8,0,0,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
                    <CheckBox Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Content="Thumbnails &amp; emblems"
                              IsChecked="{Binding IncludeBulkImages}" ToolTip="~74k player thumbnails and emblems (listed, not inspected)" />
                </Grid>

                <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Kind" Width="80" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="Group" Width="190" DisplayMemberBinding="{Binding Group}" />
                            <GridViewColumn Header="Container" Width="190" DisplayMemberBinding="{Binding Container}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E5E5" />

            <!-- details -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,10" DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Name, FallbackValue='Select a package'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Label}" Text="Path" />
                    <TextBox Style="{StaticResource Value}" Text="{Binding Path, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Label}" Text="Container" />
                    <TextBox Style="{StaticResource Value}" Text="{Binding Container, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Label}" Text="Kind / main class" />
                    <TextBox Style="{StaticResource Value}">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}{0}  ·  {1}" Mode="OneWay">
                                <Binding Path="Kind" />
                                <Binding Path="MainClass" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Style="{StaticResource Label}" Text="Exports" />
                    <TextBox Style="{StaticResource Value}" Text="{Binding ExportCount, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Label}" Text="Package size (bytes)" />
                    <TextBox Style="{StaticResource Value}" Text="{Binding Size, Mode=OneWay, StringFormat=N0}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#9A6700" TextWrapping="Wrap" Text="Android platform override: the game uses this instead of the generic asset."
                               Visibility="{Binding IsPlatformOverride, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#666" TextWrapping="Wrap" Text="Bulk image set: listed without opening the package."
                               Visibility="{Binding IsBulkImageSet, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
